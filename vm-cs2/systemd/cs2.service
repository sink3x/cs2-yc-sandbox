[Unit]
Description=Counter-Strike 2 dedicated server
After=network-online.target mariadb.service cs2-bootstrap.service
Wants=network-online.target
Requires=mariadb.service
RequiresMountsFor=/srv/cs2
StartLimitIntervalSec=0

[Service]
Type=simple
User=steam
Group=steam
WorkingDirectory=/srv/cs2
# "+" = run as root: restore from backup, update game/plugins, render config
ExecStartPre=+/usr/bin/node /opt/cs2-app/app/agent/prestart.js
ExecStart=/usr/bin/node /opt/cs2-app/app/agent/launch.js
# first start downloads ~60 GB
TimeoutStartSec=5400
TimeoutStopSec=60
KillSignal=SIGTERM
Restart=on-failure
RestartSec=20
LimitNOFILE=1048576
Nice=-5

[Install]
WantedBy=multi-user.target
