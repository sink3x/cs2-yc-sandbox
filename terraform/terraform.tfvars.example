# Copy to terraform.tfvars and fill in. Find the ids with:  yc resource-manager cloud list  /  yc resource-manager folder list
cloud_id  = "b1gyyyyyyyyyyyyyyyyy"
folder_id = "b1gxxxxxxxxxxxxxxxxx"
# zone    = "ru-central1-a"

# Players that get full admin (@css/root) on the game server. SteamID64: https://steamid.io
cs2_admins = [
  { name = "you", steamid = "76561198000000000" },
]

# Optional:
# ssh_public_key      = "ssh-ed25519 AAAA... you@host"
# panel_allowed_cidrs = ["203.0.113.7/32"]
# panel_domain        = "panel.example.com"   # default: <ip-with-dashes>.sslip.io (free, real Let's Encrypt certificate)
# cs2_cores           = 4
# cs2_memory_gb       = 8
#
# Secrets (bucket_suffix, agent_token, rcon_password, db_password, panel_users, gslt) live in
# secrets.auto.tfvars, generated by ../scripts/init-secrets.sh.
