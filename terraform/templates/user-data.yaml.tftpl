#cloud-config
# Minimal first-boot stub. Everything else (bundle, config, secrets) is pulled from the instance metadata by
# cs2-bootstrap.service on every boot, so `terraform apply` + reboot is all it takes to roll out a change.
package_update: false
write_files:
  - path: /usr/local/sbin/cs2-bootstrap.sh
    permissions: "0755"
    encoding: b64
    content: ${bootstrap_b64}
  - path: /etc/systemd/system/cs2-bootstrap.service
    permissions: "0644"
    encoding: b64
    content: ${unit_b64}
# bootcmd runs on EVERY boot. Older images shipped a bootstrap unit ordered After=cloud-final.service, which forms an
# ordering cycle with multi-user.target on reboot (systemd then silently drops the unit and everything ordered after it).
# Strip that ordering and start the unit, so already-created VMs heal themselves.
bootcmd:
  - [sh, -c, "[ -f /etc/systemd/system/cs2-bootstrap.service ] && sed -i 's/ cloud-final.service/ cloud-config.service/' /etc/systemd/system/cs2-bootstrap.service && systemctl daemon-reload && systemctl start --no-block cs2-bootstrap.service || true"]
runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, cs2-bootstrap.service]
  # --no-block: a blocking start from runcmd would wait for cloud-config/cloud-final and could deadlock
  - [systemctl, start, --no-block, cs2-bootstrap.service]
