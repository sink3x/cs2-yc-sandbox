# ---- where ------------------------------------------------------------------------------------------
variable "cloud_id" {
  description = "Yandex Cloud id (yc resource-manager cloud list)."
  type        = string
}

variable "folder_id" {
  description = "Folder that will hold everything (yc resource-manager folder list). Use a dedicated folder: the stack is easy to remove with it."
  type        = string
}

variable "zone" {
  description = "Availability zone. ru-central1 is the region closest to Moscow."
  type        = string
  default     = "ru-central1-a"
}

variable "name_prefix" {
  description = "Prefix for all resource names."
  type        = string
  default     = "sandbox-cs-1"
}

# ---- sizing -----------------------------------------------------------------------------------------
variable "cs2_platform" {
  type    = string
  default = "standard-v3"
}

variable "cs2_cores" {
  description = "vCPU of the game VM. 2 is enough for ~3 players; use 4 if the server stutters."
  type        = number
  default     = 2
}

variable "cs2_memory_gb" {
  type    = number
  default = 8
}

variable "cs2_data_disk_gb" {
  description = "Persistent disk with the CS2 install (~60 GB), plugins, MariaDB data."
  type        = number
  default     = 100
}

variable "admin_cores" {
  type    = number
  default = 2
}

variable "admin_core_fraction" {
  type    = number
  default = 20
}

variable "admin_memory_gb" {
  type    = number
  default = 1
}

# ---- network ----------------------------------------------------------------------------------------
variable "subnet_cidr" {
  type    = string
  default = "10.20.0.0/24"
}

variable "cs2_private_ip" {
  type    = string
  default = "10.20.0.10"
}

variable "admin_private_ip" {
  type    = string
  default = "10.20.0.11"
}

variable "panel_allowed_cidrs" {
  description = "Who may open the admin panel (HTTPS). The panel has its own login; restrict further if you have a fixed IP."
  type        = list(string)
  default     = ["0.0.0.0/0"]
}

variable "ssh_public_key" {
  description = "Optional ssh public key for user 'ubuntu' on both VMs. Empty = no SSH rule at all."
  type        = string
  default     = ""
}

variable "ssh_allowed_cidrs" {
  type    = list(string)
  default = ["0.0.0.0/0"]
}

variable "panel_domain" {
  description = "Hostname for the panel. Empty = <ip-with-dashes>.sslip.io (free wildcard DNS, gets a real Let's Encrypt certificate)."
  type        = string
  default     = ""
}

# ---- game ---------------------------------------------------------------------------------------------
variable "server_hostname" {
  type    = string
  default = "sandbox-cs-1"
}

variable "cs2_admins" {
  description = "Players that get full admin (@css/root) on the game server: [{ name = \"you\", steamid = \"7656119XXXXXXXXXX\" }]. Editable later in the panel."
  type = list(object({
    name    = string
    steamid = string
  }))
  default = []
}

# ---- secrets (generated by scripts/init-secrets.sh into secrets.auto.tfvars; never committed) ---------
variable "bucket_suffix" {
  description = "Random suffix: Object Storage bucket names are globally unique."
  type        = string
}

variable "agent_token" {
  type      = string
  sensitive = true
}

variable "rcon_password" {
  type      = string
  sensitive = true
}

variable "db_password" {
  type      = string
  sensitive = true
}

variable "panel_users" {
  description = "Initial panel logins: { name = password }. Change the passwords in the panel afterwards."
  type        = map(string)
  sensitive   = true
}

variable "gslt" {
  description = "Game Server Login Token (steamcommunity.com/dev/managegameservers, app id 730). Without it the server is LAN-only/unlisted."
  type        = string
  sensitive   = true
  default     = ""
}

variable "steam_web_api_key" {
  description = "Optional, only for Workshop maps (-authkey)."
  type        = string
  sensitive   = true
  default     = ""
}
